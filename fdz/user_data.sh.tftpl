#!/bin/bash
set -euo pipefail
dnf install -y python3 python3-pip amazon-cloudwatch-agent
useradd --system --home-dir /opt/fdz --shell /sbin/nologin fdz
install -d -o fdz -g fdz /opt/fdz
python3 -m venv /opt/fdz/venv
/opt/fdz/venv/bin/pip install 'boto3>=1.35,<2'
echo '${app_base64}' | base64 --decode > /opt/fdz/app.py
chown -R fdz:fdz /opt/fdz
touch /var/log/fdz-app.log
chown fdz:fdz /var/log/fdz-app.log
cat > /etc/systemd/system/fdz.service <<'UNIT'
[Unit]
Description=FDZ demo web application
After=network-online.target
Wants=network-online.target

[Service]
User=fdz
Group=fdz
WorkingDirectory=/opt/fdz
Environment=AWS_DEFAULT_REGION=${region}
Environment=TABLE_NAME=${table}
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/fdz/venv/bin/python /opt/fdz/app.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=append:/var/log/fdz-app.log
StandardError=append:/var/log/fdz-app.log

[Install]
WantedBy=multi-user.target
UNIT
cat > /opt/aws/amazon-cloudwatch-agent/etc/fdz.json <<'JSON'
{
  "agent": {"region": "${region}"},
  "logs": {"logs_collected": {"files": {"collect_list": [
    {"file_path": "/var/log/fdz-app.log", "log_group_name": "${log_group}", "log_stream_name": "{instance_id}/app"},
    {"file_path": "/var/log/cloud-init-output.log", "log_group_name": "${log_group}", "log_stream_name": "{instance_id}/bootstrap"}
  ]}}}
}
JSON
cat > /etc/logrotate.d/fdz <<'ROTATE'
/var/log/fdz-app.log {
    daily
    maxsize 10M
    rotate 3
    missingok
    notifempty
    copytruncate
    compress
    su fdz fdz
}
ROTATE
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/fdz.json
systemctl daemon-reload
systemctl enable --now fdz.service
